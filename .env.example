VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, for the installed Android app (see docs/android.md)
# VITE_GOOGLE_WEB_CLIENT_ID=   # Firebase console > Authentication > Sign-in method > Google > Web client ID
# VITE_API_BASE_URL=            # defaults to https://wellsync-mobile.vercel.app

# Server-only (Vercel environment variable, used by api/*.ts). Never prefix with VITE_.
# FIREBASE_SERVICE_ACCOUNT=   # the whole service-account JSON, on one line
# GROQ_API_KEY=               # free key from console.groq.com; without it the assistant uses built-in rules
# GROQ_MODEL=                 # optional, defaults to openai/gpt-oss-120b
